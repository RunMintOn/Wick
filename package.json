{
  "name": "wick",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "A small macOS console for native local services",
  "scripts": {
    "start": "go run .",
    "test": "go test ./...",
    "test:e2e": "node --test --test-concurrency=1 tests/*.test.cjs",
    "check": "go vet ./...",
    "validate": "go run . validate",
    "apply": "go run . apply",
    "recover": "go run . recover",
    "service": "go run .",
    "icon": "sh scripts/build-icon.sh",
    "skill:install": "go run . skill:install",
    "build": "npm run icon && node scripts/build.cjs",
    "dmg": "npm run build && node scripts/build-dmg.cjs"
  }
}
